{
  "name": "infra",
  "private": true,
  "type": "module",
  "scripts": {
    "ssl:generate-domains": "node scripts/ssl/generate-domains-conf.mjs",
    "ssl:generate-domains:dry": "node scripts/ssl/generate-domains-conf.mjs --dry-run",
    "ssl:certbot": "sudo bash ssl-setup/certbot-run.sh",
    "ssl:certbot:grouped": "sudo bash ssl-setup/certbot-run.sh --grouped",
    "ssl:certbot:renew": "sudo bash ssl-setup/certbot-run.sh --renew",
    "ssl:certbot:force-all": "sudo bash ssl-setup/certbot-run.sh --force-all",
    "ssl:certbot:dry": "sudo bash ssl-setup/certbot-run.sh --dry-run",
    "validate": "node scripts/validate/index.mjs",
    "validate:remote": "node scripts/validate/index.mjs --remote",
    "render": "node scripts/render/index.mjs",
    "build:edge-static": "node scripts/build/index.mjs --edge-static",
    "build:edge-static:stub": "node scripts/build/index.mjs --edge-static --stub",
    "build:isolated-preview": "node scripts/build/index.mjs --isolated-preview",
    "build:isolated-preview:stub": "node scripts/build/index.mjs --isolated-preview --stub",
    "build:shared-node-preview": "node scripts/build/index.mjs --shared-node-preview",
    "build:shared-node-preview:stub": "node scripts/build/index.mjs --shared-node-preview --stub",
    "preview:edge-static:render": "node scripts/preview/edge-static.mjs render",
    "preview:edge-static:up": "node scripts/preview/edge-static.mjs up",
    "preview:edge-static:down": "node scripts/preview/edge-static.mjs down",
    "preview:isolated:render": "node scripts/preview/isolated.mjs render",
    "preview:isolated:up": "node scripts/preview/isolated.mjs up",
    "preview:isolated:down": "node scripts/preview/isolated.mjs down",
    "preview:shared-node:render": "node scripts/preview/shared-node.mjs render",
    "preview:shared-node:up": "node scripts/preview/shared-node.mjs up",
    "preview:shared-node:down": "node scripts/preview/shared-node.mjs down",
    "server:bootstrap": "bash -c 'scp scripts/server/bootstrap-server.sh $SERVER:/tmp/bootstrap-server.sh && ssh $SERVER sudo bash /tmp/bootstrap-server.sh'",
    "infisical": "infisical",
    "infisical:whoami": "node -e \"try{console.log(JSON.parse(require('fs').readFileSync(require('os').homedir()+'/.infisical/infisical-config.json','utf8')))}catch(e){console.log('not logged in')}\"",
    "infisical:switch": "infisical user switch",
    "infisical:login": "infisical login",
    "infisical:init": "infisical init",
    "infisical:pull": "node scripts/infisical/pull.mjs",
    "infisical:pull:development": "node scripts/infisical/pull.mjs --env=dev",
    "infisical:pull:development:force": "node scripts/infisical/pull.mjs --env=dev --force",
    "infisical:pull:staging": "node scripts/infisical/pull.mjs --env=staging",
    "infisical:pull:staging:force": "node scripts/infisical/pull.mjs --env=staging --force",
    "infisical:pull:production": "node scripts/infisical/pull.mjs --env=prod",
    "infisical:pull:production:force": "node scripts/infisical/pull.mjs --env=prod --force",
    "infisical:pull:dev": "node scripts/infisical/pull.mjs --env=dev",
    "infisical:pull:dev:force": "node scripts/infisical/pull.mjs --env=dev --force",
    "infisical:pull:prod": "node scripts/infisical/pull.mjs --env=prod",
    "infisical:pull:prod:force": "node scripts/infisical/pull.mjs --env=prod --force",
    "with-secrets": "bash -c 'if [ \"$USE_INFISICAL\" = \"1\" ]; then exec infisical run --env=${INFISICAL_ENV:-development} -- \"$@\"; else exec \"$@\"; fi' --",
    "release:publish": "node scripts/deploy/publish.mjs",
    "release:publish:prod": "node scripts/deploy/publish.mjs --tls",
    "release:apply": "node scripts/deploy/apply.mjs",
    "release:rollback": "node scripts/rollback/index.mjs"
  },
  "dependencies": {
    "@infisical/cli": "^0.43.76",
    "yaml": "^2.5.1"
  }
}
